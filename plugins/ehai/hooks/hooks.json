{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/start\" hooks/agent-idle.mjs",
            "async": true,
            "timeout": 4
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/start\" hooks/turn-telemetry.mjs",
            "async": true,
            "timeout": 4
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/start\" hooks/prompt-context.mjs",
            "async": false,
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/start\" hooks/turn-telemetry.mjs",
            "async": true,
            "timeout": 4
          }
        ]
      }
    ]
  }
}
