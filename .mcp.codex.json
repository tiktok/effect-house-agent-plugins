{
  "mcpServers": {
    "EHAIPlugin": {
      "command": "./scripts/start",
      "args": [
        "scripts/bootstrap.mjs"
      ],
      "env_vars": [
        "CODEX_HOME",
        "HTTPS_PROXY",
        "https_proxy",
        "NO_PROXY",
        "no_proxy",
        "NODE_EXTRA_CA_CERTS",
        "EHAI_HOME"
      ],
      "env": {
        "EHAI_PLUGIN_VERSION": "0.0.132",
        "EHAI_PLUGIN_DISTRIBUTION": "public",
        "EHAI_UPDATE_MANIFEST_URL": "https://raw.githubusercontent.com/tiktok/effect-house-agent-plugins/main/.claude-plugin/plugin.json",
        "EHAI_UPDATE_SUPPORT_URL": "https://raw.githubusercontent.com/tiktok/effect-house-agent-plugins/main/support.json",
        "EHAI_MARKETPLACE": "effect-house",
        "EHAI_WORKSPACE_FROM_HOST": "codex"
      },
      "startup_timeout_sec": 60,
      "tool_timeout_sec": 600,
      "cwd": "."
    },
    "EHAI": {
      "command": "./scripts/start",
      "args": [
        "scripts/eh-kernel.mjs"
      ],
      "env_vars": [
        "CODEX_HOME",
        "HTTPS_PROXY",
        "https_proxy",
        "NO_PROXY",
        "no_proxy",
        "NODE_EXTRA_CA_CERTS",
        "EHAI_HOME"
      ],
      "env": {
        "EHAI_PLUGIN_VERSION": "0.0.132",
        "EHAI_PLUGIN_DISTRIBUTION": "public",
        "EHAI_UPDATE_MANIFEST_URL": "https://raw.githubusercontent.com/tiktok/effect-house-agent-plugins/main/.claude-plugin/plugin.json",
        "EHAI_UPDATE_SUPPORT_URL": "https://raw.githubusercontent.com/tiktok/effect-house-agent-plugins/main/support.json",
        "EHAI_MARKETPLACE": "effect-house",
        "EHAI_WORKSPACE_FROM_HOST": "codex"
      },
      "startup_timeout_sec": 60,
      "tool_timeout_sec": 660,
      "cwd": "."
    }
  }
}
